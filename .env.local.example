NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
# server only — the ONLY database credential. RLS is on with no policies,
# so nothing reaches the tables except these routes, behind the PIN.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Who can get in. Name:PIN, comma separated, four digits each. The PIN is the
# identity — it says who you are, and every write is logged under that name.
# Unset = no lock locally, and a deployment that refuses to serve.
ROLODECK_USERS=Name:0000,Other:1111
# Google Places autocomplete for the invite field (server-side only, optional)
GOOGLE_PLACES_API_KEY=your-google-places-key
# Optional. Instagram shows a datacenter IP a login wall, so deployed photo
# pulls come back empty without this. It's the `sessionid` cookie from a browser
# you're logged into — use a throwaway account, and expect to redo it whenever
# that account signs out.
IG_SESSIONID=
