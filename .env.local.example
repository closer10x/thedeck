NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# server only — used to cache Instagram avatars and photos into Supabase Storage
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# the app's PIN lock. unset = no lock; set it and the whole app is gated
ROLODECK_PIN=
# Google Places autocomplete for the invite field (server-side only, optional)
GOOGLE_PLACES_API_KEY=your-google-places-key
